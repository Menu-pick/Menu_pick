# 서버에서: cp 로 복사하지 말고 ~/bobpick/.env 를 새로 만들어 값 채우기 (권한 600)
# 이 파일(.env.example)에는 진짜 값을 넣지 마세요.

DOCKERHUB_USERNAME=
BACKEND_TAG=latest

# nginx: 처음엔 http, 인증서 받은 뒤 https
NGINX_CONF=http
API_DOMAIN=

# DB (openssl rand -hex 24 로 생성)
DB_USERNAME=menupick
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 카카오 REST API 키
KAKAO_REST_API_KEY=

# CORS 허용 주소 (쉼표로 구분, 끝에 / 없이)
CORS_ALLOWED_ORIGINS=http://localhost:5173
